          "refId": "B",
          "expr": "sum by (service) (label_replace(sum by (application_name) (pg_stat_activity_count{application_name=~\"$pool_app\"}), \"node\", \"$1\", \"application_name\", \"(.+)\") * on(node) group_left(service) count by (node, service) (pool_maximum_pool_size))",
