<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Журналы уходят отправкой в otel-collector (→ Loki): вторая подписка на те же события
         вешается кодом (OtelLogBridge) от провайдера журналов, который собирает Boot, —
         Logback-конфигурация об этом не знает. Вывод в консоль остаётся прежним,
         docker compose logs работает как раньше. -->

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>