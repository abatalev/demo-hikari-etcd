# Переопредели любые значения и подними стенд с ними: cp .env.example .env && make up
# Ничего из этого заполнять не обязательно: в docker-compose.yml у всех переменных есть дефолты.

# --- базы данных: своя база на сервис ---
POSTGRES_DB=demo
POSTGRES_USER=app
POSTGRES_PASSWORD=app
# Потолок соединений базы. Держи его в пределах PROV_ACTIVE_MAX_CONNECTIONS + запас: сумма долей
# = N, поэтому флот занимает N, и превышение сверх потолка отказывает база. Запас полезно держать
# меньше доли одного инстанса (N/4) — тогда поломку порядка выдачи мест ловит сама база — и больше
# того, что занимает стенд сам (7-9 соединений: внутренние бэкенды, сборщик, psql). При N=100
# и доле 25 это 120: запас 20, свободными остаются 11-12. Роль стенда суперпользователь, поэтому
# psql и сборщик проходят по зарезервированным слотам даже когда флот упёрся.
POSTGRES_MAX_CONNECTIONS=120
POSTGRES_PORT_A=5432
POSTGRES_PORT_B=5433

# --- etcd ---
ETCD_PORT=2379
ETCD_PEER_PORT=2380
# Корень ключей конфигурации; путь инстанса: {root}/{service}/{group}/{instance}/hikari/
ETCD_ROOT=/config
# --- состав флота: реплики групп через docker compose --scale ---
# Список инстансов в конфигурации больше не хранится: число реплик группы задаётся здесь,
# а сам состав объявляет docker compose ps (make instances). Идентичность инстанса приходит
# из окружения (см. service/src/main/resources/application.yml): instance = короткий ID
# контейнера (HOSTNAME внутри контейнера), он же POOL_NAME и имя узла регистрации в etcd.
A_G1=2
A_G2=2
B_G1=2
B_G2=2
# Бюджет соединений сервиса: N делится провижором между активными инстансами, сумма долей = N.
# Ключи {ETCD_ROOT}/services/{service}/activeMaxConnections и .../activeMinConnections создаются
# провижором при появлении первого узла сервиса, если их нет, и переживают опустение сервиса
# (rolling update).
PROV_ACTIVE_MAX_CONNECTIONS=100
# Минимальная доля активного инстанса: обслуживаются только те, кому досталось не меньше этого.
# Если бюджета не хватает, часть инстансов остаётся без конфигурации и не отвечает на трафик (503).
PROV_ACTIVE_MIN_CONNECTIONS=1
# Резерв неактивного флота R: размер пула инстансов неактивных групп (маркер
# {ETCD_ROOT}/groups/{group}/active=false). 0 = холод (конфигурации нет вовсе, 503),
# 1..200 = тёплый пул ровно R. Активным достаётся N − R×k.
PROV_INACTIVE_MAX_CONNECTIONS=1
# Верхняя граница доли; зеркалит верхний предел размера пула сервиса, доли выше неё усекаются.
PROV_MAX_SHARE=200
# Стартовые ключи, которыми провижинёр обеспечивает новый инстанс при его регистрации
# (кладёт атомарно и только отсутствующие — существующие значения, в т.ч. ручные правки, не трогает).
# maximumPoolSize сюда не входит: это управляемый ключ, его приводит к доле бюджета пересчёт.
PROV_CONNECTION_TIMEOUT_MS=3000
# TTL аренды выборов лидера провизора: после краха лидера запасной перехватывает сервис
# в пределах TTL (10с). Имена реплик (PROV_NAME) заданы в docker-compose.yml — не дублируй.
PROV_LEADER_TTL=10s

# --- сервисы ---
# Размер пула задаётся ТОЛЬКО etcd-конфигурацией провижера (POOL_MAX_SIZE удалён): локальный
# дефолт максимума 0, пул не создаётся до первого конфига. Инстанс без доли бюджета держит пул
# закрытым и не обслуживает трафик (503, readiness: DOWN).
# true = после расширения пула сразу открыть нужное число коннектов (удобно для демо)
POOL_EAGER_FILL=true
# Сколько ждать доработки активных соединений при пересоздании пула (смена jdbcUrl/кредов)
POOL_DRAIN_TIMEOUT=3s

# --- балансировщик: один Traefik, точка входа на сервис (web-a -> сервис a, web-b -> сервис b) ---
# Список бэкендов в файле больше не хранится: Traefik читает метки на контейнерах инстансов
# через docker-провайдер (docker.sock смонтирован на чтение), и что развёрнуто — то и балансируется.
LB_A_PORT=8080
LB_B_PORT=8081

# --- наблюдение: единая дверь сигналов и её хранилища, сборщик метрик, сборщик метрик базы,
# витрина ---
# Порты на хосте. По одному сборщику метрик на базу: sessions пулов видны в сборщике своей базы.
# Ни один из этих контейнеров не входит в цепочки depends_on: недоступность наблюдения не должна
# мешать подъёму стенда и обслуживанию трафика.
# Дверь принимает все три сигнала приложений на одном порту (OTLP/HTTP), 9464 — её текстовая точка
# метрик, её же опрашивает сборщик.
OTLP_PORT=4318
OTEL_METRICS_PORT=9464
TEMPO_PORT=3200
LOKI_PORT=3100
# Доля запросов, попадающих в трассу: 1.0 — всё (разбор перехода), 0.01 — меньше помехи под
# долгой нагрузкой. События механизма (применение конфигурации, пересоздание пула, дренаж) отбираются
# всегда и при доле 0.
OTEL_TRACES_SAMPLING=1.0
PROM_PORT=9090
EXPORTER_PORT_A=9187
EXPORTER_PORT_B=9188
GRAFANA_PORT=3000

# --- нагрузчик: своя точка на каждый сервис (loadgen-a -> lb:80, loadgen-b -> lb:81) ---
WORKERS=4
WORK_MS=25
THINK_MS=0
REPORT_MS=2000
# 0 = крутится, пока не остановишь (docker compose stop loadgen-a loadgen-b)
DURATION_S=0