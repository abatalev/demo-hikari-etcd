# Переопредели любые значения и подними стенд с ними: cp .env.example .env && make up
# Ничего из этого заполнять не обязательно: в docker-compose.yml у всех переменных есть дефолты.

# --- postgres ---
POSTGRES_DB=demo
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_PORT=5432

# --- etcd ---
ETCD_PORT=2379
ETCD_PEER_PORT=2380
# Корень ключей конфигурации; путь инстанса: {root}/{service}/{group}/{instance}/hikari/
ETCD_ROOT=/config
# Канонический список инстансов: service|group|instance|hostPort (через пробел).
# Его читают compose и Makefile (адресация ручных правок).
# Должен совпадать с блоками service-* в docker-compose.yml (порты 18081-18088).
ETCD_INSTANCES="service-a|group-1|service-a-group-1-1|18081 service-a|group-1|service-a-group-1-2|18082 service-a|group-2|service-a-group-2-1|18083 service-a|group-2|service-a-group-2-2|18084 service-b|group-1|service-b-group-1-1|18085 service-b|group-1|service-b-group-1-2|18086 service-b|group-2|service-b-group-2-1|18087 service-b|group-2|service-b-group-2-2|18088"
# Бюджет соединений сервиса: N делится провижором поровну между живыми инстансами, сумма долей = N.
# Ключи {ETCD_ROOT}/services/{service}/maxConnections и .../minConnections создаются провижором при
# появлении первого узла сервиса, если их нет, и переживают опустение сервиса (rolling update).
PROV_MAX_CONNECTIONS=100
# Минимальная доля инстанса: обслуживаются только те, кому досталось не меньше этого. Если бюджета
# не хватает, часть инстансов остаётся без конфигурации и не отвечает на трафик (503).
PROV_MIN_CONNECTIONS=1
# Верхняя граница доли; зеркалит POOL_MAX_SIZE_MAX у сервиса, доли выше неё усекаются.
PROV_MAX_SHARE=200
# Стартовые ключи, которыми провижинёр обеспечивает новый инстанс при его регистрации
# (кладёт атомарно и только отсутствующие — существующие значения, в т.ч. ручные правки, не трогает).
# maximumPoolSize сюда не входит: это управляемый ключ, его приводит к доле бюджета пересчёт.
PROV_CONNECTION_TIMEOUT_MS=3000
# TTL аренды выборов лидера провизора: после краха лидера запасной перехватывает сервис
# в пределах TTL (10с). Имена реплик (PROV_NAME) заданы в docker-compose.yml — не дублируй.
PROV_LEADER_TTL=10s

# --- сервисы ---
# Дефолт приложения до первой конфигурации из etcd (провижёр пришлёт долю бюджета сразу).
# ВНИМАНИЕ: инстанс, которому не досталась доля, держит пул на этом локальном дефолте —
# трафик он не обслуживает (503), но соединения к базе открыть может.
POOL_MAX_SIZE=10
# true = после расширения пула сразу открыть нужное число коннектов (удобно для демо)
POOL_EAGER_FILL=true
# Сколько ждать доработки активных соединений при пересоздании пула (смена jdbcUrl/кредов)
POOL_DRAIN_TIMEOUT=3s

# --- балансировщики nginx (lb-a -> сервис a, lb-b -> сервис b) ---
LB_A_PORT=8080
LB_B_PORT=8081

# --- нагрузчик ---
WORKERS=4
WORK_MS=25
THINK_MS=0
REPORT_MS=2000
# 0 = крутится, пока не остановишь (docker compose stop loadgen)
DURATION_S=0