# Шаблон конфига балансировщика. Официальный образ nginx подставляет ${BACKEND_N}
# из env (envsubst) в /etc/nginx/templates/. BACKEND_1..4 задаются в docker-compose.yml.
upstream pool_instances {
    server ${BACKEND_1} max_fails=1 fail_timeout=5s;
    server ${BACKEND_2} max_fails=1 fail_timeout=5s;
    server ${BACKEND_3} max_fails=1 fail_timeout=5s;
    server ${BACKEND_4} max_fails=1 fail_timeout=5s;
}

server {
    # dual-stack обязателен: образный healthcheck (wget http://localhost/healthz)
    # резолвит localhost в ::1, и без IPv6-слушателя контейнер вечно unhealthy.
    listen 80;
    listen [::]:80;

    # Точка для healthcheck'а балансировщика (make up ждёт её).
    location = /healthz {
        return 200 "ok\n";
        default_type text/plain;
    }

    location / {
        proxy_pass http://pool_instances;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_connect_timeout 2s;
        proxy_read_timeout 30s;
        # Неготовый инстанс отвечает 503 (гейт конфигурации) — пробуем следующий.
        # max_fails/fail_timeout выводят смоченный инстанс из ротации на 5с.
        proxy_next_upstream error timeout http_502 http_503;
    }
}